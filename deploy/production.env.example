# Template only. Keep real values in /etc/rmg-shop/backend.env (root:root, 0600).
RMG_RELEASE=REPLACE_WITH_TESTED_RELEASE_TAG
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://rmglabels.duckdns.org
TRUST_PROXY=1
UPLOADS_DIR=/var/lib/rmg-shop/uploads
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://rmg_shop:REPLACE_WITH_DB_PASSWORD@db:5432/rmg_shop_production
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MAIL_MODE=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# This sender only supports testing to the Resend account's own email.
# Change to a verified sending domain before sending to customers.
MAIL_FROM=onboarding@resend.dev
