generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ActorType {
  ADMIN
  GUEST
  SYSTEM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  DELIVERY_FAILED
  RETURNED_TO_SHOP
}

enum OrderMethod {
  COD
  BANK_TRANSFER
}

enum OrderSource {
  WEB
  INSTAGRAM
}

enum InventoryEffectSource {
  ADMIN_ADJUSTMENT
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_SHIP
}

enum TokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  name String @db.VarChar(80)
  passwordHash String @db.VarChar(255)
  role Role @default(CUSTOMER)
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  disabledAt DateTime? @db.Timestamptz(6)
  sessionVersion Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tokens AuthToken[]
  uploads UploadAsset[]
  movements InventoryMovement[]
  orders Order[]
  orderHistory OrderStatusHistory[]
  @@map("users")
}

model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.VarChar(64)
  kind TokenKind
  expiresAt DateTime @db.Timestamptz(6)
  usedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([userId, kind])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// connect-pg-simple's server-side store; not exposed to HTTP clients.
model Session {
  sid String @id @db.VarChar(255)
  sess Json @db.JsonB
  expire DateTime @db.Timestamptz(6)
  @@index([expire])
  @@map("sessions")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(80)
  slug String @unique @db.VarChar(120)
  active Boolean @default(true)
  version Int @default(0)
  products Product[]
  @@map("categories")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(120)
  description String @db.VarChar(5000)
  status ProductStatus @default(DRAFT)
  priceFrom Decimal @db.Decimal(14, 0)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  variants Variant[]
  images ProductImage[]
  @@index([status, categoryId, createdAt])
  @@map("products")
}

model Variant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku String @unique @db.VarChar(64)
  size String @db.VarChar(16)
  color String @db.VarChar(40)
  price Decimal @db.Decimal(14, 0)
  active Boolean @default(true)
  inventory Inventory?
  movements InventoryMovement[]
  orderItems OrderItem[]
  @@unique([productId, size, color])
  @@map("variants")
}

model Inventory {
  variantId String @id @db.Uuid
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  onHand Int @default(0)
  reserved Int @default(0)
  version Int @default(0)
  @@map("inventory")
}

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Nullable for GUEST/SYSTEM order effects; history responses always carry a display name.
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorType ActorType @default(ADMIN)
  source InventoryEffectSource @default(ADMIN_ADJUSTMENT)
  // Deterministic per-effect reference for order operations; admin adjustments keep NULL and rely on (actorId, key).
  effectKey String? @unique @db.VarChar(160)
  key String @db.VarChar(120)
  requestHash String @db.VarChar(64)
  delta Int
  reason String @db.VarChar(300)
  before Int
  after Int
  reserved Int
  version Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([actorId, key])
  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model UploadAsset {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  storageKey String @unique @db.VarChar(80)
  width Int
  height Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  image ProductImage?
  @@index([createdAt])
  @@map("upload_assets")
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  assetId String @unique @db.Uuid
  asset UploadAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  position Int
  @@unique([productId, position])
  @@map("product_images")
}

// Single row ("default"); missing row means safe built-in defaults. No default bank account.
model ShopSettings {
  id String @id @default("default") @db.VarChar(16)
  shippingFeeVnd Int @default(30000)
  bankDeadlineMinutes Int @default(120)
  bankName String? @db.VarChar(120)
  bankBin String? @db.VarChar(20)
  bankAccountNumber String? @db.VarChar(32)
  bankAccountName String? @db.VarChar(120)
  version Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@map("shop_settings")
}

// Server-priced draft of a cart; never holds stock. Order creation re-verifies against current data.
model CheckoutQuote {
  id String @id @default(uuid()) @db.Uuid
  items Json
  method OrderMethod
  currency String @default("VND") @db.VarChar(3)
  subtotalVnd Decimal @db.Decimal(14, 0)
  shippingFeeVnd Decimal @db.Decimal(14, 0)
  totalVnd Decimal @db.Decimal(14, 0)
  settingsVersion Int
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  orders Order[]
  @@index([expiresAt])
  @@map("checkout_quotes")
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(24)
  status OrderStatus @default(PENDING)
  source OrderSource @default(WEB)
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  quoteId String? @db.Uuid
  quote CheckoutQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  recipientName String @db.VarChar(120)
  phone String @db.VarChar(20)
  email String? @db.VarChar(254)
  province String @db.VarChar(100)
  district String @db.VarChar(100)
  ward String @db.VarChar(100)
  addressLine String @db.VarChar(255)
  note String? @db.VarChar(500)
  method OrderMethod
  currency String @default("VND") @db.VarChar(3)
  subtotalVnd Decimal @db.Decimal(14, 0)
  shippingFeeVnd Decimal @db.Decimal(14, 0)
  totalVnd Decimal @db.Decimal(14, 0)
  settingsVersion Int
  bankDeadlineAt DateTime? @db.Timestamptz(6)
  // SHA-256 of the guest lookup token; the plaintext token is never stored.
  lookupTokenHash String? @unique @db.VarChar(64)
  trackingNumber String? @db.VarChar(100)
  deliveredAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)
  cancelReason String? @db.VarChar(500)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  items OrderItem[]
  history OrderStatusHistory[]
  @@index([status, createdAt])
  @@index([phone])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName String @db.VarChar(120)
  sku String @db.VarChar(64)
  size String @db.VarChar(16)
  color String @db.VarChar(40)
  unitPriceVnd Decimal @db.Decimal(14, 0)
  quantity Int
  lineTotalVnd Decimal @db.Decimal(14, 0)
  @@unique([orderId, variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus OrderStatus
  actorType ActorType
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason String? @db.VarChar(500)
  version Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Server-scoped mutation replay bookkeeping (m4-contract §7); response is stored for safe replays.
model IdempotencyRecord {
  id String @id @default(uuid()) @db.Uuid
  scope String @db.VarChar(60)
  identity String @db.VarChar(120)
  key String @db.VarChar(120)
  requestHash String @db.VarChar(64)
  resourceId String? @db.VarChar(64)
  response Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  @@unique([scope, identity, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
