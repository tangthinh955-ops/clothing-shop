{
  "name": "@clothing/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names tsc,api \"tsc -p tsconfig.json --watch\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "npm run build && node --env-file-if-exists=.env.test ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:generate": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:test": "node --env-file-if-exists=.env.test ../../node_modules/prisma/build/index.js migrate deploy",
    "admin:create": "npm run build && node --env-file-if-exists=.env dist/cli/create-admin.js",
    "seed:demo": "npm run build && node --env-file-if-exists=.env dist/cli/seed-demo.js",
    "import:products": "npm run build && node --env-file-if-exists=.env dist/cli/import-products.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-pg-simple": "10.0.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "9.2.5",
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
