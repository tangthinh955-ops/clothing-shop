# Local only. Copy to .env and generate SESSION_SECRET before starting.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://clothing:local_dev_only@localhost:5433/clothing_local
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TRUST_PROXY=false
SWAGGER_ENABLED=true
# preview stores test mail only in ignored .local/mailbox; never use in production.
MAIL_MODE=preview
MAIL_PREVIEW_DIR=../../.local/mailbox
RESEND_API_KEY=
MAIL_FROM=
