# Local only. Copy to .env and generate SESSION_SECRET before starting.
NODE_ENV=development
PORT=3000
# Production on the VPS: keep 127.0.0.1 when Caddy/nginx runs on the same host (0.0.0.0 only inside a container network).
HOST=127.0.0.1
DATABASE_URL=postgresql://clothing:local_dev_only@localhost:5433/clothing_local
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# false locally; on the VPS the number of reverse-proxy hops in front of the API (1 for Caddy/nginx). Required in production.
TRUST_PROXY=false
# Absolute folder for product images. Empty locally (uses .local/uploads); required in production on a persistent, backed-up disk, e.g. /var/lib/rmg-shop/uploads.
UPLOADS_DIR=
SWAGGER_ENABLED=true
# preview stores test mail only in ignored .local/mailbox; never use in production.
MAIL_MODE=preview
MAIL_PREVIEW_DIR=../../.local/mailbox
RESEND_API_KEY=
MAIL_FROM=
